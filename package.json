{
  "name": "depth-lidar",
  "productName": "Depth Lidar",
  "version": "0.1.0",
  "description": "3D 스캔 후처리 앱 (뷰어·메시 편집·정렬·퓨전·텍스처·측정)",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "electron": "electron .",
    "package": "electron-packager . \"Depth Lidar\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(src|tests|release|\\.tools|public|docs|node_modules/\\.vite)($|/)\" --prune=true"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "meshoptimizer": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
